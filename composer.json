{
    "name": "sti/sti",
    "description": "sTi - 紫微斗数+星座融合的 AI 人格画像",
    "license": "proprietary",
    "require": {
        "yansongda/pay": "^3.0",
        "vlucas/phpdotenv": "^5.5",
        "hyperf/pimple": "^2.2",
        "firebase/php-jwt": "^7.2"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^11.0"
    },
    "config": {
        "allow-plugins": {
            "composer/security-audit": false,
            "dealerdirect/phpcodesniffer": false
        },
        "audit": {
            "block-insecure": false
        }
    }
}
